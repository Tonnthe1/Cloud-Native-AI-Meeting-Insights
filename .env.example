# Database Configuration
POSTGRES_USER=meetinguser
POSTGRES_PASSWORD=yourpassword
POSTGRES_DB=meeting_insights
# "db" inside Docker Compose; use localhost and port 5433 when running the
# backend on your machine against the Compose database.
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Alternatively, a full SQLAlchemy URL overrides the POSTGRES_* values:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# OpenAI API Configuration (for AI summaries)
# Leave empty to fall back to extractive summaries (key sentences from the
# transcript); failed OpenAI requests fall back the same way.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# API Security (optional)
# When set, every API request must send a matching X-API-Key header. For the
# web UI to keep working, set NEXT_PUBLIC_API_KEY to the same value; it is
# embedded in the browser bundle, so treat it as a shared secret, not auth.
# API_KEY=your_optional_api_key
# NEXT_PUBLIC_API_KEY=your_optional_api_key

# Whisper Model Configuration
# ".en" models are English-only; use a multilingual model (e.g. base, small)
# to transcribe other languages.
FW_MODEL=base.en
FW_COMPUTE_TYPE=float32

# File Upload Configuration
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_MB=200

# Worker Configuration
USE_WORKER_SERVICE=true
WORKER_HEALTH_PORT=8001

# Frontend
# URL the browser uses to reach the API (baked in at frontend build time)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Debug mode: include exception details in 500 responses
DEBUG=false
