# Database
POSTGRES_USER=meetinguser
POSTGRES_PASSWORD=change-me
POSTGRES_DB=meeting_insights
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis queue and cache
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
MAX_QUEUE_SIZE=100
MAX_JOB_ATTEMPTS=3
JOB_TTL_SECONDS=86400

# Privacy-first AI routing.
# local: use LOCAL_LLM_BASE_URL when configured, otherwise deterministic local extraction.
# openai: explicitly permit transcript content to be sent to OpenAI.
AI_PROVIDER=local
LOCAL_LLM_BASE_URL=
LOCAL_LLM_API_KEY=local
LOCAL_LLM_MODEL=meeting-insights
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# API security
API_KEY=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Transcription. Use a multilingual model name (small/medium/large-v3), not base.en.
FW_MODEL=small
FW_DEVICE=cpu
FW_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=
WHISPER_BEAM_SIZE=5

# Shared object storage.
# Docker Compose uses the bundled MinIO service. For a single-process local run,
# set STORAGE_BACKEND=local and STORAGE_LOCAL_DIR to a writable directory.
STORAGE_BACKEND=s3
STORAGE_LOCAL_DIR=/app/uploads
S3_BUCKET=meeting-insights
S3_ENDPOINT_URL=http://minio:9000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=change-me-minio
# The current product does not expose audio playback, so raw recordings are
# deleted after successful transcription by default. Set false to retain them.
DELETE_AUDIO_AFTER_PROCESSING=true

# Processing
USE_WORKER_SERVICE=true
ALLOW_SYNC_FALLBACK=false
WORKER_HEALTH_PORT=8001
LOG_LEVEL=INFO
DEBUG=false
